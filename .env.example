DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/promptune_db

JWT_SECRET=your_secret_token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_IN_MINUTES=15
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

LLM_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=groq
LLM_API_KEY=your_llm_api_key
# Optional: OpenAI-compatible endpoint (OpenRouter, vLLM, LiteLLM...)
LLM_BASE_URL=

AGENT_RUN_MAX_ATTEMPTS=3
AGENT_RUN_RETRY_DELAY_SECONDS=15
AGENT_RUN_TIMEOUT_SECONDS=90

RABBITMQ_URL=amqp://app:app@localhost:5672/
WORKER_PREFETCH=1
